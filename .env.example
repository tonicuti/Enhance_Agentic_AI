# Ollama and llama.cpp model servers
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen3:1.7b
EMBEDDING_MODEL=embeddinggemma:latest
RERANKER_MODEL=qllama/bge-reranker-v2-m3:latest
RERANKER_BASE_URL=http://localhost:8080

# Pinecone vector store
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX_NAME=agentic-ai-enterprise
PINECONE_NAMESPACE=enterprise-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Neo4j graph store
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

# Inference timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=120
